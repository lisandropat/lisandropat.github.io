---
interface Props {
  visible?: boolean;
}

const { visible = true } = Astro.props;

const MAIL = 'lisandropat@gmail.com';
---

{
  visible && (
    <div class="pointer-events-none fixed bottom-[20px] left-0 z-50 flex w-full justify-center px-[20px]">
  <div
    class="availability-bar pointer-events-auto flex items-center gap-[14px] rounded-full border border-white/15 bg-black/70 px-[20px] py-[12px] text-[14px] text-white shadow-lg backdrop-blur-xl"
  >
    <span class="relative flex h-[8px] w-[8px] shrink-0" aria-hidden="true">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:animate-none"
      ></span>
      <span class="relative inline-flex h-[8px] w-[8px] rounded-full bg-emerald-400"></span>
    </span>

    <span class="whitespace-nowrap">Available for work</span>

    <span class="h-[14px] w-px shrink-0 bg-white/25" aria-hidden="true"></span>

      <a href={`mailto:${MAIL}`} class="whitespace-nowrap">
          <span class="line-grow-white">Reach out via email</span>
        </a>
      </div>
    </div>
  )
}

<style>
  .availability-bar {
    --appear: 200vh;
    --appear-end: 212vh;
  }

  @keyframes bar-appear {
    from {
      opacity: 0;
      pointer-events: none;
    }
    to {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @keyframes bar-rise {
    from {
      translate: 0 1rem;
    }
    to {
      translate: 0 0;
    }
  }

  @supports (animation-timeline: scroll()) {
    .availability-bar {
      animation-name: bar-appear;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: var(--appear) var(--appear-end);
    }

    @media (prefers-reduced-motion: no-preference) {
      .availability-bar {
        animation-name: bar-appear, bar-rise;
        animation-range: var(--appear) var(--appear-end), var(--appear) var(--appear-end);
      }
    }
  }
</style>