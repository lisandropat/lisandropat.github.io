<button type="button" class="scroll-arrow" aria-label="Scroll to top">
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5" />
    <path d="m5 12 7-7 7 7" />
  </svg>
</button>

<script>
  const arrow = document.querySelector<HTMLButtonElement>('.scroll-arrow');

  if (arrow) {
    const check = () => arrow.classList.toggle('show', window.scrollY > 400);
    window.addEventListener('scroll', check, { passive: true });
    check();

    arrow.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>
