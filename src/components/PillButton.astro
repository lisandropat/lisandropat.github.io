---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['pill-btn', className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="label"><slot /></span>
  <span class="bg"></span>
</a>
